# ============================================================================
# 文件名: Makefile
# 描述: Makefile构建脚本（GNU Make）
# 作者: C++学习项目
# 说明: 使用g++编译C++学习项目，适用于Linux/macOS/MinGW环境
# ============================================================================

# ============================================================================
# 编译器与编译选项
# ============================================================================

# C++编译器
CXX := g++

# C++标准：使用C++17
# -std=c++17: 启用C++17标准支持
CXXFLAGS := -std=c++17

# 头文件搜索路径
# -I 表示添加头文件搜索目录
INCLUDES := -I include

# 编译警告选项
# -Wall: 开启大部分常见警告
# -Wextra: 开启额外的警告
# -Wpedantic: 严格遵循C++标准，禁止使用扩展
WARNINGS := -Wall -Wextra -Wpedantic

# 优化选项
# -O0: 不优化，编译快，便于调试（Debug模式）
# -O2: 二级优化，发布版本常用（Release模式）
# 可以通过 make DEBUG=1 来使用Debug模式
ifeq ($(DEBUG), 1)
    CXXFLAGS += -O0 -g        # -g 生成调试信息
else
    CXXFLAGS += -O2           # 发布模式优化
endif

# 组合所有编译选项
CXXFLAGS += $(INCLUDES) $(WARNINGS)

# ============================================================================
# 目录与文件
# ============================================================================

# 源文件目录
SRC_DIR := src

# 目标文件输出目录
BUILD_DIR := build

# 可执行文件名
TARGET := cpp_learning

# 收集所有源文件
# wildcard 函数用于匹配文件
# 递归查找所有子目录下的.cpp文件
SRCS := $(wildcard $(SRC_DIR)/*.cpp) \
        $(wildcard $(SRC_DIR)/basics/*.cpp) \
        $(wildcard $(SRC_DIR)/oop/*.cpp) \
        $(wildcard $(SRC_DIR)/stl/*.cpp) \
        $(wildcard $(SRC_DIR)/advanced/*.cpp) \
        $(wildcard $(SRC_DIR)/patterns/*.cpp)

# 将源文件路径转换为目标文件路径
# 例如: src/main.cpp -> build/main.o
# patsubst 函数用于模式替换
OBJS := $(patsubst $(SRC_DIR)/%.cpp, $(BUILD_DIR)/%.o, $(SRCS))

# 依赖文件（用于增量编译）
DEPS := $(OBJS:.o=.d)

# ============================================================================
# 默认目标
# ============================================================================

# all 是默认目标，执行 make 时会构建这个目标
.PHONY: all
all: $(TARGET)
	@echo ""
	@echo "编译完成！可执行文件: $(TARGET)"
	@echo "运行方式: ./$(TARGET)"

# ============================================================================
# 链接目标
# ============================================================================

# 链接所有目标文件生成可执行文件
# $@ 表示目标文件（即 $(TARGET)）
# $^ 表示所有依赖文件（即 $(OBJS)）
$(TARGET): $(OBJS)
	@echo "链接中..."
	$(CXX) $(CXXFLAGS) -o $@ $^

# ============================================================================
# 编译源文件为目标文件
# ============================================================================

# 模式规则：将 src/xxx.cpp 编译为 build/xxx.o
# $< 表示第一个依赖文件（即源文件）
# -MMD -MP 用于生成依赖文件，确保头文件修改后能重新编译
$(BUILD_DIR)/%.o: $(SRC_DIR)/%.cpp
	@echo "编译: $<"
	@mkdir -p $(dir $@)    # 确保目标目录存在
	$(CXX) $(CXXFLAGS) -MMD -MP -c -o $@ $<

# ============================================================================
# 包含依赖文件
# - 表示如果文件不存在不要报错
# ============================================================================
-include $(DEPS)

# ============================================================================
# 清理目标
# ============================================================================

# .PHONY 声明这些是伪目标，不是真实文件
.PHONY: clean
clean:
	@echo "清理构建文件..."
	rm -rf $(BUILD_DIR) $(TARGET)
	@echo "清理完成"

# ============================================================================
# 运行目标
# ============================================================================

.PHONY: run
run: $(TARGET)
	@echo "运行程序..."
	./$(TARGET)

# ============================================================================
# 调试目标
# ============================================================================

.PHONY: debug
debug:
	@$(MAKE) DEBUG=1 all

# ============================================================================
# 帮助信息
# ============================================================================

.PHONY: help
help:
	@echo "C++学习项目 Makefile 使用说明"
	@echo ""
	@echo "可用目标:"
	@echo "  make          - 编译项目 (Release模式)"
	@echo "  make debug    - 编译项目 (Debug模式，带调试信息)"
	@echo "  make run      - 编译并运行程序"
	@echo "  make clean    - 清理构建文件"
	@echo "  make help     - 显示此帮助信息"
	@echo ""
	@echo "编译选项:"
	@echo "  编译器: $(CXX)"
	@echo "  C++标准: C++17"
	@echo "  警告: $(WARNINGS)"

# ============================================================================
# 注意事项
# ============================================================================
# - 使用 make -j4 可以并行编译，加速编译过程
# - 修改头文件后，源文件会自动重新编译（通过.d依赖文件）
# - Windows下需要使用 MinGW 或 WSL 环境才能使用此Makefile
# - Windows原生环境请使用 build.bat 或 CMake
# ============================================================================
